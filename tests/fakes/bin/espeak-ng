#!/usr/bin/env python3
"""Fake OS voice: reads the text from stdin, waits as long as speaking it takes, logs it."""
import json, os, sys, time
args = sys.argv[1:]
wpm = int(args[args.index("-s") + 1]) if "-s" in args else 175
text = sys.stdin.read()
log = os.environ.get("FAKE_AUDIO_LOG")
if log:
    with open(log, "a") as f:
        f.write(json.dumps({"t": time.time(), "what": "espeak", "text": text, "wpm": wpm}) + "\n")
time.sleep(max(0.2, len(text.split()) / max(60, wpm) * 60))
