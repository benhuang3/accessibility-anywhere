+++ b/ally/senses/vision.py
@@ -0,0 +1,172 @@
+"""Webcam struggle detectors: squinting and leaning in. Owner: Hayden.
+
+Uses MediaPipe Face Landmarker blendshapes (eyeSquintLeft/Right) and face size for lean.
+    pip install mediapipe opencv-python
+    download the model (once) next to this file:
+    https://storage.googleapis.com/mediapipe-models/face_landmarker/face_landmarker/float16/1/face_landmarker.task
+
+The pure parts (SquintDetector, LeanDetector) take numbers and timestamps, so they test without a camera.
+"Where to zoom" = the mouse cursor for now (gaze is a timeboxed experiment; swap in cursor_point()).
+"""
+
+from __future__ import annotations
+
+import logging
+import threading
+import time
+from pathlib import Path
+
+from ..contracts import Struggle, Target
+
+log = logging.getLogger("ally")
+MODEL = Path(__file__).with_name("face_landmarker.task")
+
+
+class SquintDetector:
+    """Squint held above `threshold` for `hold` seconds, relative to the person's own resting baseline."""
+
+    def __init__(self, threshold: float = 0.35, hold: float = 0.8, refractory: float = 8.0):
+        self.threshold, self.hold, self.refractory = threshold, hold, refractory
+        self.baseline: float | None = None
+        self._since: float | None = None
+        self._last_fire = -1e9
+
+    def feed(self, squint_l: float, squint_r: float, t: float | None = None) -> Struggle | None:
+        t = time.time() if t is None else t
+        s = (squint_l + squint_r) / 2
+        if self.baseline is None:
+            self.baseline = s
+        lift = s - self.baseline
+        if lift < self.threshold * 0.5:  # relaxed: slowly learn this person's resting face
+            self.baseline = 0.98 * self.baseline + 0.02 * s
+        if lift >= self.threshold:
+            self._since = t if self._since is None else self._since
+            if t - self._since >= self.hold and t - self._last_fire >= self.refractory:
+                self._last_fire, self._since = t, None
+                return Struggle("squint", min(1.0, 0.5 + lift), source="vision",
+                                detail={"squint": round(s, 3), "baseline": round(self.baseline, 3)}, ts=t)
+        else:
+            self._since = None
+        return None
+
+
+class LeanDetector:
+    """Face width (e.g. distance between outer eye corners, normalized) growing past baseline = leaning in."""
+
+    def __init__(self, ratio: float = 1.18, hold: float = 1.0, refractory: float = 8.0):
+        self.ratio, self.hold, self.refractory = ratio, hold, refractory
+        self.baseline: float | None = None
+        self._since: float | None = None
+        self._last_fire = -1e9
+
+    def feed(self, face_width: float, t: float | None = None) -> Struggle | None:
+        t = time.time() if t is None else t
+        if face_width <= 0:
+            return None
+        if self.baseline is None:
+            self.baseline = face_width
+        r = face_width / self.baseline
+        if r < 1.05:
+            self.baseline = 0.97 * self.baseline + 0.03 * face_width
+        if r >= self.ratio:
+            self._since = t if self._since is None else self._since
+            if t - self._since >= self.hold and t - self._last_fire >= self.refractory:
+                self._last_fire, self._since = t, None
+                return Struggle("lean", min(1.0, 0.4 + (r - 1)), source="vision", detail={"ratio": round(r, 3)}, ts=t)
+        else:
+            self._since = None
+        return None
+
+
+def cursor_point() -> tuple[int, int] | None:
+    try:
+        import ctypes
+
+        class POINT(ctypes.Structure):
+            _fields_ = [("x", ctypes.c_long), ("y", ctypes.c_long)]
+        p = POINT()
+        ctypes.windll.user32.GetCursorPos(ctypes.byref(p))
+        return p.x, p.y
+    except Exception:
+        try:
+            from pynput.mouse import Controller
+            x, y = Controller().position
+            return int(x), int(y)
+        except Exception:
+            return None
+
+
+def target_here() -> Target:
+    p = cursor_point()
+    if not p:
+        return Target()
+    x, y = p
+    return Target(x=x, y=y, box=(x - 220, y - 130, 440, 260))
+
+
+class VisionSensor:
+    """Camera thread: frames -> FaceLandmarker -> detectors -> bus. No-op with a clear error if deps missing."""
+
+    def __init__(self, bus, camera_index: int = 0, fps: float = 15):
+        self.bus, self.camera_index, self.fps = bus, camera_index, fps
+        self.squint, self.lean = SquintDetector(), LeanDetector()
+        self.error = ""
+        self._stop = threading.Event()
+        self.last = {}  # latest raw numbers, for a debug panel
+
+    def start(self) -> bool:
+        try:
+            import cv2  # noqa: F401
+            import mediapipe  # noqa: F401
+        except Exception as e:
+            self.error = f"vision off: pip install mediapipe opencv-python ({e})"
+            log.warning(self.error)
+            return False
+        if not MODEL.exists():
+            self.error = f"vision off: download face_landmarker.task to {MODEL}"
+            log.warning(self.error)
+            return False
+        threading.Thread(target=self._run, name="vision", daemon=True).start()
+        return True
+
+    def stop(self):
+        self._stop.set()
+
+    def _run(self):
+        import cv2
+        import mediapipe as mp
+        from mediapipe.tasks.python import BaseOptions
+        from mediapipe.tasks.python.vision import FaceLandmarker, FaceLandmarkerOptions, RunningMode
+
+        opts = FaceLandmarkerOptions(base_options=BaseOptions(model_asset_path=str(MODEL)),
+                                     running_mode=RunningMode.VIDEO, num_faces=1,
+                                     output_face_blendshapes=True)
+        cap = cv2.VideoCapture(self.camera_index, cv2.CAP_DSHOW) if hasattr(cv2, "CAP_DSHOW") \
+            else cv2.VideoCapture(self.camera_index)
+        try:
+            with FaceLandmarker.create_from_options(opts) as lm:
+                while not self._stop.is_set():
+                    ok, frame = cap.read()
+                    if not ok:
+                        time.sleep(0.2)
+                        continue
+                    rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
+                    res = lm.detect_for_video(mp.Image(image_format=mp.ImageFormat.SRGB, data=rgb),
+                                              int(time.monotonic() * 1000))
+                    if res.face_blendshapes:
+                        b = {c.category_name: c.score for c in res.face_blendshapes[0]}
+                        pts = res.face_landmarks[0]
+                        width = abs(pts[263].x - pts[33].x)  # outer eye corners, normalized 0..1
+                        self.last = {"eyeSquintLeft": b.get("eyeSquintLeft", 0),
+                                     "eyeSquintRight": b.get("eyeSquintRight", 0), "face_width": width}
+                        for s in (self.squint.feed(b.get("eyeSquintLeft", 0), b.get("eyeSquintRight", 0)),
+                                  self.lean.feed(width)):
+                            if s is not None:
+                                s.target = target_here()
+                                self.bus.publish("struggle", s)
+                    time.sleep(max(0.0, 1 / self.fps - 0.01))
+        except Exception as e:
+            self.error = f"vision crashed: {e}"
+            log.exception("vision sensor crashed")
+        finally:
+            cap.release()
