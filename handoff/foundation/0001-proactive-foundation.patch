+"""Speak an offer and listen for yes/no. Owner: Ganesh.
+
+Same interface as proactive.NullVoice:  say(text)  and  ask(offer)  (ask resolves the offer with "voice").
+Uses Ally's existing speaker (Cartesia or OS voice) and recorder + speech-to-text (Cartesia ink-whisper).
+"""
+
+from __future__ import annotations
+
+import logging
+import re
+
+log = logging.getLogger("ally")
+
+YES = {"yes", "yeah", "yep", "yup", "sure", "ok", "okay", "please", "do it", "go ahead", "alright", "absolutely",
+       "yes please", "uh huh", "mhm", "correct", "right"}
+NO = {"no", "nope", "nah", "don't", "do not", "stop", "cancel", "no thanks", "not now", "leave it", "never mind"}
+
+
+def parse_yes_no(text: str) -> str | None:
+    """'Yes please!' -> 'yes', 'no thank you' -> 'no', 'what?' -> None. Negatives win ties ('yes, no wait')."""
+    t = re.sub(r"[^a-z' ]", " ", (text or "").lower())
+    t = " " + re.sub(r"\s+", " ", t).strip() + " "
+    hit = lambda words: any(f" {w} " in t for w in words)  # noqa: E731
+    if hit(NO):
+        return "no"
+    if hit(YES):
+        return "yes"
+    return None
+
+
+class VoiceConfirm:
+    def __init__(self, agent, listen_seconds: float = 4.0, silence_seconds: float = 0.8):
+        self.agent = agent
+        self.listen_seconds, self.silence_seconds = listen_seconds, silence_seconds
+
+    def say(self, text: str):
+        try:
+            self.agent.speaker.say(text, wait=False)
+        except Exception:
+            log.exception("say failed")
+
+    def ask(self, offer):
+        try:
+            self.agent.speaker.say(offer.prompt, wait=True)  # don't record our own voice
+        except Exception:
+            log.exception("say failed")
+        ok, why = self.agent.voice.available()
+        if not ok or offer.done:
+            log.info("voice confirm: not listening (%s)", why if not ok else "already answered")
+            return
+        for _ in range(2):  # one retry if we heard something unclear
+            if offer.done:
+                return
+            text = self._listen()
+            choice = parse_yes_no(text)
+            self.agent.events.add("heard", text or "(nothing)", source="confirm")
+            if choice:
+                offer.resolve(choice, "voice")
+                return
+            if not text:
+                return  # silence: let the timer / click decide
+            self.say("Sorry, yes or no?")
+
+    def _listen(self) -> str:
+        from .voice import wav_bytes
+        v = self.agent.voice
+        try:
+            v._stop.clear()
+            if v.recorder() == "sounddevice":
+                pcm = v._record_sounddevice(self.listen_seconds, self.silence_seconds)
+            else:
+                pcm = v._record()
+            return v.transcribe(wav_bytes(pcm)) if pcm else ""
+        except Exception as e:
+            log.warning("voice confirm listen failed: %s", e)
+            return ""
