@@ -0,0 +1,69 @@
+"""Risk detection + warning wording. Owner: Ganesh.
+
+Starter heuristics only. Real signals come from extension/ content scripts (page text, form fields)
+posting {"type": "risk", ...} to /api/event, or from Python checks here calling bus.publish("risk", Risk(...)).
+"""
+
+from __future__ import annotations
+
+import re
+import urllib.parse
+
+from ..contracts import Risk
+
+WARNINGS = {
+    "scam_popup": ("This looks like a scam warning. Real companies never ask you to call a number from a pop-up.",
+                   "Careful. This pop-up looks like a scam. Don't call any number on it."),
+    "untrusted_site": ("This website may not be what it claims to be.",
+                       "Careful, this website might not be trustworthy."),
+    "remote_access": ("Someone may be trying to control your computer. Only allow this if YOU called them.",
+                      "Careful. This lets someone else control your computer."),
+    "payment_field": ("You're about to enter payment details. Check the web address first.",
+                      "You're about to type card details. Make sure this is the right website."),
+}
+
+SCAM_PHRASES = [
+    r"call (microsoft|apple|windows) support", r"your computer (is|has been) (infected|locked|blocked)",
+    r"do not (close|restart|turn off) (this|your)", r"virus(es)? (detected|found)",
+    r"(buy|purchase) (gift|itunes|google play) cards?", r"your (account|bank) (is|has been) (suspended|frozen)",
+]
+REMOTE_TOOLS = ["anydesk", "teamviewer", "ultraviewer", "quickassist", "supremo", "logmein", "screenconnect"]
+BRANDS = ["paypal", "chase", "wellsfargo", "bankofamerica", "amazon", "apple", "microsoft", "irs", "medicare"]
+
+
+def warning_for(r: Risk) -> tuple[str, str]:
+    text, spoken = WARNINGS.get(r.kind, ("This might be risky.", "Careful, this might be risky."))
+    if r.evidence:
+        text = f"{text}\n\nWhy: {r.evidence}"
+    return text, spoken
+
+
+def check_text(text: str, url: str = "") -> list[Risk]:
+    t = (text or "").lower()
+    out = []
+    for pat in SCAM_PHRASES:
+        m = re.search(pat, t)
+        if m:
+            out.append(Risk("scam_popup", "high", f'page says "{m.group(0)}"', url=url, source="text"))
+            break
+    return out
+
+
+def check_url(url: str) -> list[Risk]:
+    host = (urllib.parse.urlsplit(url).hostname or "").lower()
+    out = []
+    if any(tool in host for tool in REMOTE_TOOLS):
+        out.append(Risk("remote_access", "high", f"{host} is a remote-control tool", url=url, source="url"))
+    for b in BRANDS:  # brand name in host but not the brand's real domain, e.g. paypal-secure-login.xyz
+        if b in host.replace("-", "").replace(".", "") and not re.search(rf"(^|\.){b}\.(com|gov)$", host):
+            out.append(Risk("untrusted_site", "medium", f"{host} uses the name '{b}' but isn't {b}'s website",
+                            url=url, source="url"))
+            break
+    if re.match(r"^\d+\.\d+\.\d+\.\d+$", host):
+        out.append(Risk("untrusted_site", "medium", "the address is just numbers", url=url, source="url"))
+    return out
+
+
+def check_process_names(names: list[str]) -> list[Risk]:
+    found = [n for n in names if any(tool in n.lower().replace(" ", "") for tool in REMOTE_TOOLS)]
+    return [Risk("remote_access", "high", f"{found[0]} is running", app=found[0], source="process")] if found else []
