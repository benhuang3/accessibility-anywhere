+"""Proactive layer: contracts, bus, habits, coordinator, detectors, risk rules, voice parsing, API wiring."""
+
+from __future__ import annotations
+
+import tempfile
+import threading
+import time
+import unittest
+from pathlib import Path
+
+from helpers import temp_home
+
+from ally.contracts import ContractError, EventBus, Offer, Risk, Struggle, Target, parse_event
+from ally.habits import HabitMemory, context_key
+from ally.proactive import Coordinator, NullUI, NullVoice, fuse, pick_accommodation
+from ally.risk import check_text, check_url, warning_for
+from ally.senses.behavior import HesitationDetector, RageClickDetector, RetypeDetector
+from ally.senses.vision import LeanDetector, SquintDetector
+from ally.voice_confirm import parse_yes_no
+
+
+class FakeOut:
+    def __init__(self, ok=True):
+        self.ok = ok
+
+
+class Rig:
+    """A coordinator with fake tools/UI/voice and a controllable context."""
+
+    def __init__(self, ctx=None, cfg=None, answer=None):
+        self.bus = EventBus()
+        self.calls = []
+        self.ctx = ctx or {"app": "Google Chrome", "site": "chase.com", "in_browser": True}
+        self.memory = HabitMemory(Path(tempfile.mkdtemp()) / "habits.json")
+        self.ui, self.voice = NullUI(), NullVoice()
+        base = {"cooldown_seconds": 0, "offer_timeout_seconds": 2}
+        base.update(cfg or {})
+        self.c = Coordinator(self.bus, lambda n, a, s: self.calls.append((n, a)) or FakeOut(), self.memory,
+                             lambda: self.ctx, lambda: base, ui=self.ui, voice=self.voice)
+        self.c.start(watch_context=False)
+        if answer:  # auto-answer every offer
+            self.bus.subscribe("offer", lambda o: threading.Timer(0.05, o.resolve, (answer, "test")).start())
+
+    def struggle(self, kind="squint", conf=0.8, **kw):
+        self.bus.publish("struggle", Struggle(kind, conf, **kw))
+        self.c.wait_idle()
+
+
+class ContractTests(unittest.TestCase):
+    def test_validation(self):
+        with self.assertRaises(ContractError):
+            Struggle("blink")
+        with self.assertRaises(ContractError):
+            Risk("scam_popup", severity="huge")
+        self.assertEqual(Struggle("squint", 7).confidence, 1.0)
+        t, s = parse_event({"type": "struggle", "kind": "lean", "target": {"site": "a.com", "box": [1, 2, 3, 4]}})
+        self.assertEqual((t, s.target.site, s.target.box), ("struggle", "a.com", (1, 2, 3, 4)))
+        with self.assertRaises(ContractError):
+            parse_event({"type": "nope"})
+
+    def test_offer_first_answer_wins_and_times_out(self):
+        o = Offer("?", timeout=0.05)
+        self.assertTrue(o.resolve("yes", "voice"))
+        self.assertFalse(o.resolve("no", "overlay"))
+        self.assertEqual((o.wait(), o.answered_by), ("yes", "voice"))
+        self.assertEqual(Offer("?", timeout=0.05).wait(), "timeout")
+
+    def test_bus_isolates_crashing_handlers(self):
+        bus, got = EventBus(), []
+        bus.subscribe("x", lambda m: 1 / 0)
+        bus.subscribe("x", got.append)
+        bus.subscribe("*", got.append)
+        unsub = bus.subscribe("x", got.append)
+        unsub()
+        self.assertEqual(bus.publish("x", 5), 3)
+        self.assertEqual(got, [5, ("x", 5)])
+
+
+class HabitTests(unittest.TestCase):
+    def test_record_lookup_auto_apply_persist(self):
+        path = Path(tempfile.mkdtemp()) / "h.json"
+        m = HabitMemory(path)
+        acc = pick_accommodation("squint", True)
+        m.record("chase.com", acc, True)
+        self.assertEqual(m.auto_apply("chase.com"), [])
+        m.record("chase.com", acc, True)
+        self.assertEqual([a.key for a in HabitMemory(path).auto_apply("chase.com")], ["page_zoom_150"])
+        self.assertEqual(context_key("Chrome", "WWW.Chase.com"), "chase.com")
+        self.assertEqual(context_key("Word", ""), "word")
+
+
+class CoordinatorTests(unittest.TestCase):
+    def test_yes_applies_and_learns_then_auto_applies(self):
+        r = Rig(answer="yes")
+        r.struggle("squint", 0.8)
+        self.assertEqual(r.calls, [("set_page_zoom", {"zoom": 1.5})])
+        r.struggle("squint", 0.8)
+        self.assertEqual(len(r.calls), 2)
+        offers = [x for x in r.ui.shown if x[0] == "offer"]
+        r.struggle("squint", 0.8)  # third time: habit, no question
+        self.assertEqual(len(r.calls), 3)
+        self.assertEqual(len([x for x in r.ui.shown if x[0] == "offer"]), len(offers))
+        self.assertIn("like last time", r.voice.said[-1])
+
+    def test_no_is_remembered_and_backs_off(self):
+        r = Rig(answer="no")
+        r.struggle("rage_click", 0.9)
+        r.struggle("rage_click", 0.9)
+        self.assertEqual(r.calls, [])
+        self.assertEqual(len([x for x in r.ui.shown if x[0] == "offer"]), 1)  # second one skipped
+
+    def test_weak_signals_fuse(self):
+        self.assertAlmostEqual(fuse([Struggle("squint", 0.5), Struggle("lean", 0.5)]), 0.75)
+        r = Rig(answer="yes")
+        r.struggle("squint", 0.45)
+        self.assertEqual(r.calls, [])
+        r.struggle("lean", 0.4)
+        self.assertEqual(len(r.calls), 1)
+
+    def test_desktop_uses_screen_tools_and_cooldown(self):
+        r = Rig(ctx={"app": "Microsoft Word", "site": "", "in_browser": False}, cfg={"cooldown_seconds": 60},
+                answer="yes")
+        r.struggle("squint", 0.9)
+        r.struggle("squint", 0.9)
+        self.assertEqual(r.calls, [("magnify_screen", {"level": 2.0})])
+
+    def test_timeout_changes_nothing(self):
+        r = Rig(cfg={"offer_timeout_seconds": 0.1})
+        r.struggle("squint", 0.9)
+        self.assertEqual(r.calls, [])
+        self.assertEqual(r.memory.snapshot(), {})
+
+    def test_context_change_applies_habits(self):
+        r = Rig()
+        acc = pick_accommodation("squint", True)
+        r.memory.record("chase.com", acc, True)
+        r.memory.record("chase.com", acc, True)
+        r.ctx = {"app": "Google Chrome", "site": "news.com", "in_browser": True}
+        r.c.check_context()
+        self.assertEqual(r.calls, [])
+        r.ctx = {"app": "Google Chrome", "site": "chase.com", "in_browser": True}
+        r.c.check_context()
+        self.assertEqual(r.calls, [("set_page_zoom", {"zoom": 1.5})])
+
+    def test_risk_shows_card_and_speaks(self):
+        r = Rig()
+        r.bus.publish("risk", Risk("scam_popup", "high", "page says call microsoft support"))
+        r.c.wait_idle()
+        self.assertEqual(r.ui.shown[-1][0], "card")
+        self.assertEqual(r.ui.shown[-1][3], "risk")
+        self.assertIn("scam", r.voice.said[-1])
+
+    def test_disabled(self):
+        r = Rig(cfg={"enabled": False}, answer="yes")
+        r.struggle("squint", 1.0)
+        self.assertEqual(r.calls, [])
+
+
+class DetectorTests(unittest.TestCase):
+    def test_rage_click(self):
+        d = RageClickDetector()
+        self.assertIsNone(d.feed(100, 100, 0.0))
+        self.assertIsNone(d.feed(400, 100, 0.2))  # far away: doesn't count
+        self.assertIsNone(d.feed(105, 102, 0.4))
+        s = d.feed(98, 99, 0.6)
+        self.assertEqual(s.kind, "rage_click")
+        self.assertIsNone(d.feed(100, 100, 0.7))  # refractory
+
+    def test_retype(self):
+        d = RetypeDetector()
+        hits = [d.feed_key(True, i * 0.3) for i in range(6)]
+        self.assertEqual(hits[-1].kind, "retype")
+        self.assertIsNone(d.feed_key(False, 3))
+
+    def test_hesitation(self):
+        d = HesitationDetector(path_px=1000, window=3)
+        d.action(0)
+        out = None
+        for i in range(80):  # zig-zag for 4 s without clicking
+            out = out or d.feed_move(0 if i % 2 else 200, 300, 0.05 * i + 0.1)
+        self.assertEqual(out.kind, "hesitation")
+
+    def test_squint_needs_hold_over_baseline(self):
+        d = SquintDetector()
+        for i in range(20):
+            self.assertIsNone(d.feed(0.1, 0.1, i * 0.1))  # resting baseline
+        self.assertIsNone(d.feed(0.6, 0.6, 2.0))
+        self.assertIsNone(d.feed(0.6, 0.6, 2.4))
+        self.assertEqual(d.feed(0.6, 0.6, 2.9).kind, "squint")
+
+    def test_lean(self):
+        d = LeanDetector()
+        d.feed(0.20, 0.0)
+        self.assertIsNone(d.feed(0.26, 1.0))
+        self.assertEqual(d.feed(0.26, 2.1).kind, "lean")
+
+
+class RiskAndVoiceTests(unittest.TestCase):
+    def test_risk_rules(self):
+        self.assertEqual(check_text("WARNING! Your computer has been locked. Call Microsoft Support")[0].kind,
+                         "scam_popup")
+        self.assertEqual(check_text("Welcome to the recipe blog"), [])
+        self.assertEqual(check_url("https://paypal-secure-login.xyz/a")[0].kind, "untrusted_site")
+        self.assertEqual(check_url("https://www.paypal.com/signin"), [])
+        self.assertEqual(check_url("https://anydesk.com/download")[0].kind, "remote_access")
+        self.assertIn("Why:", warning_for(Risk("scam_popup", evidence="x"))[0])
+
+    def test_yes_no(self):
+        for t, want in [("Yes please!", "yes"), ("yeah sure", "yes"), ("no thank you", "no"), ("Nope.", "no"),
+                        ("what?", None), ("", None), ("okay", "yes"), ("not now", "no")]:
+            self.assertEqual(parse_yes_no(t), want, t)
+
+
+class AgentWiringTests(unittest.TestCase):
+    def test_event_api_and_answer_through_agent(self):
+        from ally.agent import Agent
+        a = Agent(temp_home('[proactive]\ncooldown_seconds = 0\nvoice_confirm = false\n'), start_hotkeys=False)
+        try:
+            self.assertEqual(a.config.errors, [])
+            self.assertFalse(a.publish_event({"type": "struggle", "kind": "blink"})["ok"])
+            calls = []
+            a.proactive.call_tool = lambda n, args, src: calls.append(n) or FakeOut()
+            a.proactive.context_fn = lambda: {"app": "Google Chrome", "site": "chase.com", "in_browser": True}
+            a.proactive.start(watch_context=False)
+            self.assertTrue(a.publish_event({"type": "struggle", "kind": "squint", "confidence": 0.9})["ok"])
+            for _ in range(100):
+                if a.proactive.pending:
+                    break
+                time.sleep(0.02)
+            self.assertIsNotNone(a.status()["proactive"]["pending"])
+            a.publish_event({"type": "answer", "choice": "yes"})
+            a.proactive.wait_idle()
+            self.assertEqual(calls, ["set_page_zoom"])
+            self.assertIn("chase.com", a.habits.snapshot())
+        finally:
+            a.close()
+
+    def test_bad_proactive_config_is_reported(self):
+        from ally.config import parse, validate, merge
+        errors, _ = validate(merge(parse('[proactive]\nmin_confidence = 3\n')))
+        self.assertTrue(errors)
+
+
+if __name__ == "__main__":
+    unittest.main()
