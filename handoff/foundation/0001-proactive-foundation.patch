index 0000000..73b62f3
--- /dev/null
+++ b/ally/senses/behavior.py
@@ -0,0 +1,139 @@
+"""Mouse/keyboard struggle detectors. Owner: Hayden.
+
+Detectors are pure (feed them events with timestamps, get a Struggle or None) so they are unit-testable.
+BehaviorSensor wires them to pynput (pip install pynput) and publishes to the bus.
+Tune the numbers live by watching the dashboard event log.
+"""
+
+from __future__ import annotations
+
+import collections
+import logging
+import math
+import time
+
+from ..contracts import Struggle, Target
+
+log = logging.getLogger("ally")
+
+
+class RageClickDetector:
+    """N+ clicks within `window` seconds inside `radius` px = frustration (button too small / not responding)."""
+
+    def __init__(self, n: int = 3, window: float = 1.5, radius: float = 30, refractory: float = 3.0):
+        self.n, self.window, self.radius, self.refractory = n, window, radius, refractory
+        self.clicks: collections.deque = collections.deque(maxlen=20)
+        self._last_fire = -1e9
+
+    def feed(self, x: int, y: int, t: float | None = None) -> Struggle | None:
+        t = time.time() if t is None else t
+        self.clicks.append((x, y, t))
+        near = [c for c in self.clicks if t - c[2] <= self.window and math.dist((x, y), c[:2]) <= self.radius]
+        if len(near) >= self.n and t - self._last_fire >= self.refractory:
+            self._last_fire = t
+            self.clicks.clear()
+            conf = min(1.0, 0.55 + 0.1 * (len(near) - self.n + 1))
+            return Struggle("rage_click", conf, Target(x=x, y=y, box=(x - 60, y - 40, 120, 80)),
+                            source="behavior", detail={"clicks": len(near)}, ts=t)
+        return None
+
+
+class RetypeDetector:
+    """Lots of backspacing in a short time = they can't see what they typed (or keep mistyping)."""
+
+    def __init__(self, backspaces: int = 6, window: float = 4.0, refractory: float = 10.0):
+        self.need, self.window, self.refractory = backspaces, window, refractory
+        self.times: collections.deque = collections.deque(maxlen=50)
+        self._last_fire = -1e9
+
+    def feed_key(self, is_backspace: bool, t: float | None = None) -> Struggle | None:
+        t = time.time() if t is None else t
+        if not is_backspace:
+            return None
+        self.times.append(t)
+        n = sum(1 for x in self.times if t - x <= self.window)
+        if n >= self.need and t - self._last_fire >= self.refractory:
+            self._last_fire = t
+            self.times.clear()
+            return Struggle("retype", min(1.0, 0.5 + 0.03 * n), source="behavior", detail={"backspaces": n}, ts=t)
+        return None
+
+
+class HesitationDetector:
+    """Mouse wandering a lot without clicking or typing = lost / doesn't know where to go next."""
+
+    def __init__(self, path_px: float = 2500, window: float = 6.0, refractory: float = 20.0):
+        self.path_px, self.window, self.refractory = path_px, window, refractory
+        self.moves: collections.deque = collections.deque(maxlen=2000)
+        self._last_action = time.time()
+        self._last_fire = -1e9
+
+    def action(self, t: float | None = None):
+        """Call on any click or key press: resets the clock."""
+        self._last_action = time.time() if t is None else t
+        self.moves.clear()
+
+    def feed_move(self, x: int, y: int, t: float | None = None) -> Struggle | None:
+        t = time.time() if t is None else t
+        self.moves.append((x, y, t))
+        while self.moves and t - self.moves[0][2] > self.window:
+            self.moves.popleft()
+        if t - self._last_action < self.window or t - self._last_fire < self.refractory:
+            return None
+        pts = list(self.moves)
+        dist = sum(math.dist(pts[i][:2], pts[i + 1][:2]) for i in range(len(pts) - 1))
+        if dist >= self.path_px:
+            self._last_fire = t
+            self.moves.clear()
+            return Struggle("hesitation", min(0.9, 0.5 + dist / (self.path_px * 10)), Target(x=x, y=y),
+                            source="behavior", detail={"path_px": round(dist)}, ts=t)
+        return None
+
+
+class BehaviorSensor:
+    """pynput listeners -> detectors -> bus.publish("struggle", ...). Safe no-op if pynput is missing."""
+
+    def __init__(self, bus):
+        self.bus = bus
+        self.rage, self.retype, self.hesitation = RageClickDetector(), RetypeDetector(), HesitationDetector()
+        self._mouse = self._keys = None
+        self.error = ""
+
+    def _emit(self, s: Struggle | None):
+        if s is not None:
+            self.bus.publish("struggle", s)
+
+    def start(self) -> bool:
+        try:
+            from pynput import keyboard, mouse
+        except Exception as e:  # ImportError, or no display
+            self.error = f"pynput unavailable: {e}"
+            log.warning("behavior sensor off: %s", self.error)
+            return False
+
+        def on_click(x, y, button, pressed):
+            if pressed:
+                self.hesitation.action()
+                self._emit(self.rage.feed(int(x), int(y)))
+
+        def on_move(x, y):
+            self._emit(self.hesitation.feed_move(int(x), int(y)))
+
+        def on_press(key):
+            self.hesitation.action()
+            self._emit(self.retype.feed_key(key == keyboard.Key.backspace))
+
+        self._mouse = mouse.Listener(on_click=on_click, on_move=on_move)
+        self._keys = keyboard.Listener(on_press=on_press)
+        self._mouse.daemon = self._keys.daemon = True
+        self._mouse.start()
+        self._keys.start()
+        return True
+
+    def stop(self):
+        for l in (self._mouse, self._keys):
+            if l is not None:
+                try:
+                    l.stop()
+                except Exception:
+                    pass
