+// ---------------------------------------------------------------- proactive help
+
+const SIGNALS = [
+  ["squint", "Squinting"],
+  ["lean", "Leaning in"],
+  ["rage_click", "Rapid clicking"],
+  ["hesitation", "Hesitating"],
+  ["retype", "Retyping"],
+];
+const SIGNAL_LIFE = 10; // seconds a reading stays visible while it fades out
+const TRACE_MAX = 14;
+const TRACE_LABEL = {
+  struggle: ["Noticed", "info"],
+  offer: ["Asked", "info"],
+  applied: ["Did it", "good"],
+  proactive: ["Held back", "muted"],
+  risk: ["Warned", "warn"],
+  error: ["Problem", "bad"],
+};
+const SENSOR_NAME = { BehaviorSensor: "Mouse and keyboard", VisionSensor: "Camera" };
+
+let minConfidence = 0.6; // read from config.toml, same default as the agent
+let autoAfter = 2;
+const readings = {}; // kind -> { value, ts }
+let fusedReading = { value: 0, ts: 0, kinds: "" };
+let offerShown = { id: null, since: 0, sent: false };
+const trace = [];
+
+function setMeter(meter, value) {
+  const v = Math.max(0, Math.min(1, value));
+  meter.querySelector(".fill").style.width = `${Math.round(v * 100)}%`;
+  meter.setAttribute("aria-valuenow", v.toFixed(2));
+  meter.setAttribute("aria-valuetext", `${Math.round(v * 100)} percent`);
+  meter.classList.toggle("hot", v >= minConfidence);
+}
+
+function buildSignals() {
+  const rows = SIGNALS.map(([kind, label]) => {
+    const meter = el("div", { class: "meter", role: "meter", "aria-valuemin": "0", "aria-valuemax": "1", "aria-valuenow": "0",
+      "aria-label": label }, el("div", { class: "fill" }));
+    return el("li", { "data-kind": kind }, el("span", { class: "sig-label", text: label }), meter,
+      el("span", { class: "meter-value", text: "0.00" }));
+  });
+  $("signals").replaceChildren(...rows);
+}
+
+function fade(reading, now) {
+  if (!reading) return 0;
+  const age = now - reading.ts;
+  return age >= SIGNAL_LIFE ? 0 : reading.value * (1 - age / SIGNAL_LIFE);
+}
+
+function renderMeters() {
+  const now = Date.now() / 1000;
+  for (const li of $("signals").children) {
+    const v = fade(readings[li.dataset.kind], now);
+    setMeter(li.querySelector(".meter"), v);
+    li.querySelector(".meter-value").textContent = v.toFixed(2);
+  }
+  const f = fade(fusedReading, now);
+  setMeter($("fused-meter"), f);
+  $("fused-value").textContent = f.toFixed(2);
+  $("fused-tick").style.left = `${Math.round(minConfidence * 100)}%`;
+  $("fused-note").textContent = f >= minConfidence
+    ? "That is enough for Ally to offer help."
+    : f > 0.05 ? "Ally is watching. It only asks when the overall level passes the line." : "All calm.";
+}
+
+function recordEvent(ev) {
+  const kind = ev.kind;
+  const d = ev.data || {};
+  if (kind === "struggle") {
+    // "squint 0.45 (fused 0.62 from lean, squint)"; structured fields win if the agent adds them
+    const m = /^(\w+) ([\d.]+) \(fused ([\d.]+) from ([^)]*)\)/.exec(ev.text);
+    const sk = d.kind || (m && m[1]);
+    const conf = d.confidence !== undefined ? Number(d.confidence) : m ? Number(m[2]) : NaN;
+    const fz = d.fused !== undefined ? Number(d.fused) : m ? Number(m[3]) : NaN;
+    if (sk && !Number.isNaN(conf)) readings[sk] = { value: conf, ts: ev.ts };
+    if (!Number.isNaN(fz)) fusedReading = { value: fz, ts: ev.ts, kinds: m ? m[4] : "" };
+  }
+  if (!TRACE_LABEL[kind]) return;
+  trace.unshift({ id: ev.id, ts: ev.ts, kind: kind === "offer" && ev.text.startsWith("answer:") ? "answer" : kind, text: ev.text });
+  trace.length = Math.min(trace.length, TRACE_MAX);
+  if (kind === "applied" || kind === "offer") scheduleHabits();
+}
+
+let habitsTimer = null;
+function scheduleHabits() {
+  clearTimeout(habitsTimer);
+  habitsTimer = setTimeout(loadHabits, 300);
+}
+
+const WHY = { accepted: "you said yes", habit: "like last time" };
+const RISK_NAME = {
+  scam_popup: "Possible scam",
+  untrusted_site: "Unfamiliar website",
+  remote_access: "Remote-control tool",
+  payment_field: "Payment details",
+};
+
+function plainTrace(t) {
+  if (t.kind === "struggle") {
+    return t.text.replace(/^(\w+) ([\d.]+) \(fused ([\d.]+) from ([^)]*)\)/, (_, k, c, f, kinds) => {
+      const list = kinds.split(", ");
+      return `${k.replaceAll("_", " ")} at ${c} · overall ${f}${list.length > 1 ? ` (${list.map((x) => x.replaceAll("_", " ")).join(" + ")})` : ""}`;
+    });
+  }
+  if (t.kind === "answer") return t.text.replace(/^answer: (\w+).*/, (_, c) => `You said ${c}`);
+  if (t.kind === "risk") {
+    return t.text.replace(/^(\w+) \[\w+\] ?/, (_, k) => `${RISK_NAME[k] || "Possible risk"}${t.text.length > _.length ? ": " : ""}`);
+  }
+  if (t.kind === "applied") return t.text.replace(/ \((\w+)\)$/, (m, why) => (WHY[why] ? `, ${WHY[why]}` : m));
+  return t.text;
+}
+
+function renderTrace() {
+  if (!trace.length) {
+    $("trace").replaceChildren(el("li", { class: "empty", text: "Nothing yet. When Ally notices you struggling, each step shows up here." }));
+    return;
+  }
+  $("trace").replaceChildren(...trace.map((t) => {
+    const [label, tone] = t.kind === "answer" ? ["You answered", "info"] : TRACE_LABEL[t.kind];
+    return el("li", { class: "step " + tone },
+      el("time", { text: new Date(t.ts * 1000).toLocaleTimeString() }),
+      el("b", { class: "step-label", text: label }),
+      el("span", { text: plainTrace(t) }));
+  }));
+}
+
+async function answerOffer(choice) {
+  const offer = lastOffer;
+  if (!offer || offerShown.sent) return;
+  offerShown.sent = true;
+  $("offer-actions").hidden = true;
+  $("offer-text").textContent = choice === "yes" ? "Thank you. Doing it now." : "Okay, I will leave it.";
+  try {
+    await api("POST", "/api/event", { type: "answer", choice, offer_id: offer.id });
+  } catch (e) {
+    $("offer-text").textContent = "Could not send your answer: " + e.message;
+  }
+  pollStatus();
+}
+
+let lastOffer = null;
+
+function renderProactive(p) {
+  if (!p) return;
+  const sensorBits = (p.sensors || []).map((s) => (s.error ? `${SENSOR_NAME[s.name] || s.name}: ${s.error}` : null)).filter(Boolean);
+  const where = p.context && p.context !== "unknown" ? `Watching ${p.context}` : "Watching";
+  const state = $("pro-state");
+  state.textContent = sensorBits.length ? `${where} · ${sensorBits.join(" · ")}` : where;
+  state.classList.toggle("warn", sensorBits.length > 0);
+
+  const pending = p.pending;
+  lastOffer = pending;
+  if (pending) {
+    if (offerShown.id !== pending.id) offerShown = { id: pending.id, since: performance.now(), sent: false };
+    if (!offerShown.sent) {
+      $("offer-text").textContent = pending.prompt;
+      $("offer-actions").hidden = false;
+      const total = Math.max(1, Number(pending.timeout) || 8) * 1000;
+      $("offer-timer").value = Math.min(1, (performance.now() - offerShown.since) / total);
+    }
+    $("offer").classList.add("open");
+  } else {
+    offerShown = { id: null, since: 0, sent: false };
+    $("offer-actions").hidden = true;
+    $("offer-text").textContent = "Nothing to ask right now. Ally will speak up if you seem to be struggling.";
+    $("offer").classList.remove("open");
+  }
+}
+
+async function loadHabits() {
+  let habits = {};
+  try {
+    habits = (await api("GET", "/api/habits")).habits || {};
+  } catch {
+    return;
+  }
+  const box = $("habits");
+  const contexts = Object.entries(habits).filter(([, acc]) => Object.keys(acc).length);
+  $("forget-all").hidden = !contexts.length;
+  if (!contexts.length) {
+    box.replaceChildren(el("p", { class: "empty", text: "Nothing yet. Say yes to a suggestion a couple of times and Ally will remember what you like on that site." }));
+    return;
+  }
+  box.replaceChildren(...contexts.map(([ctx, accs]) => {
+    const forget = el("button", { class: "small", text: "Forget this site", "aria-label": `Forget what Ally learned on ${ctx}` });
+    forget.addEventListener("click", async () => {
+      await api("POST", "/api/habits", { forget: true, context: ctx });
+      loadHabits();
+    });
+    const rows = Object.values(accs).map((a) => {
+      const auto = a.accepted >= autoAfter && a.accepted > a.declined;
+      const label = (a.accommodation && a.accommodation.label) || "an adjustment";
+      return el("li", {}, el("span", { text: `${label[0].toUpperCase()}${label.slice(1)}` }),
+        el("span", { class: "hint", text: ` · you said yes ${a.accepted}×, no ${a.declined}×` }),
+        auto ? el("span", { class: "tag ai", text: "does this on its own" }) : "");
+    });
+    return el("div", { class: "habit" }, el("div", { class: "habit-head" }, el("h4", { text: ctx }), forget), el("ul", {}, ...rows));
+  }));
+}
+
+$("offer-yes").addEventListener("click", () => answerOffer("yes"));
+$("offer-no").addEventListener("click", () => answerOffer("no"));
+
+$("forget-all").addEventListener("click", async () => {
+  if (!confirm("Make Ally forget everything it learned about you?")) return;
+  await api("POST", "/api/habits", { forget: true });
+  loadHabits();
+});
+
+const DEMOS = {
+  squint: [{ type: "struggle", kind: "squint", confidence: 0.45 }, { type: "struggle", kind: "lean", confidence: 0.4 }],
+  rage: [{ type: "struggle", kind: "rage_click", confidence: 0.85 }],
+  scam: [{ type: "risk", kind: "scam_popup", severity: "high", evidence: "the page says your computer is locked" }],
+};
+for (const btn of document.querySelectorAll("[data-demo]")) {
+  btn.addEventListener("click", async () => {
+    for (const body of DEMOS[btn.dataset.demo]) await api("POST", "/api/event", { ...body, source: "dashboard demo" });
+    pollEvents();
+    pollStatus();
+  });
+}
+
+function readConfigNumbers(text) {
+  const min = /^\s*min_confidence\s*=\s*([\d.]+)/m.exec(text || "");
+  const auto = /^\s*auto_apply_after\s*=\s*(\d+)/m.exec(text || "");
+  if (min) minConfidence = Number(min[1]);
+  if (auto) autoAfter = Number(auto[1]);
+}
+
 // ---------------------------------------------------------------- start
 
+buildSignals();
+renderTrace();
+renderMeters();
 pollStatus();
 pollEvents();
+loadHabits();
 loadTools().catch(() => {});
 loadConfig().catch(() => {});
-setInterval(pollStatus, 3000);
-setInterval(pollEvents, 1500);
+setInterval(pollStatus, 1000);
+setInterval(pollEvents, 1000);
+setInterval(renderMeters, 250);
+setInterval(loadHabits, 5000);
 $("ask-input").focus();
