 footer span { flex: 1 1 auto; }
+
+/* ---- proactive help */
+.pro { border-width: 2px; }
+.pro-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 16px; }
+.pro-state { margin: 0; color: var(--muted); }
+.pro h3 { margin: 22px 0 8px; font-size: 1.1rem; }
+.pro h4 { margin: 0; font-size: 1.05rem; }
+
+.offer { margin-top: 12px; padding: 14px 16px; border: 2px dashed var(--line); border-radius: 12px; }
+.offer.open { border-style: solid; border-color: var(--accent); background: color-mix(in srgb, var(--accent) 10%, var(--card)); }
+.offer-text { margin: 0; font-size: 1.5rem; line-height: 1.35; font-weight: 600; }
+.offer:not(.open) .offer-text { font-size: 1.1rem; font-weight: 400; color: var(--muted); }
+.offer-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-top: 14px; }
+button.big { min-height: 64px; padding: 12px 32px; font-size: 1.35rem; }
+#offer-timer { flex: 1 1 140px; height: 14px; accent-color: var(--accent); }
+
+.fused, .signals li { display: grid; grid-template-columns: 11rem 1fr 3.2rem; align-items: center; gap: 12px; }
+.fused { margin-bottom: 4px; font-weight: 700; }
+.signals { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
+.sig-label { font-weight: 600; }
+.meter { position: relative; height: 18px; border: 2px solid var(--line); border-radius: 999px; background: var(--bg); overflow: hidden; }
+.meter .fill { height: 100%; width: 0; background: var(--accent); transition: width 0.25s linear; }
+.meter.hot .fill { background: var(--warn); }
+.meter .tick { position: absolute; top: -2px; bottom: -2px; width: 3px; margin-left: -1px; background: var(--fg); }
+.meter-value { font-variant-numeric: tabular-nums; text-align: right; }
+
+.trace { list-style: none; margin: 0; padding: 0 0 0 14px; border-left: 3px solid var(--line); display: grid; gap: 8px; }
+.trace .step { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; position: relative; }
+.trace .step::before { content: ""; position: absolute; left: -22px; top: 0.55em; width: 11px; height: 11px; border-radius: 50%;
+  background: var(--card); border: 3px solid currentColor; }
+.trace time { color: var(--muted); font-variant-numeric: tabular-nums; font-size: 0.9rem; }
+.step-label { min-width: 6.5rem; }
+.step.info { color: var(--accent); }
+.step.good { color: var(--good); }
+.step.warn { color: var(--warn); }
+.step.bad { color: var(--bad); }
+.step.muted { color: var(--muted); }
+.step span:last-child { color: var(--fg); }
+.empty { color: var(--muted); margin: 0; }
+
+.habit { padding: 10px 0; border-bottom: 1px solid color-mix(in srgb, var(--line) 35%, transparent); }
+.habit-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; }
+.habit ul { list-style: none; margin: 6px 0 0; padding: 0; }
+.habit li { padding: 2px 0; }
+.demo { margin-top: 18px; }
+.demo summary { cursor: pointer; font-weight: 600; }
+
+@media (max-width: 560px) {
+  .fused, .signals li { grid-template-columns: 1fr 3.2rem; }
+  .fused-label, .sig-label { grid-column: 1 / -1; }
+}
