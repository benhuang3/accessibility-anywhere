+"""Category scoring without quoting sensitive page text."""
+import re
+import unicodedata
+from ..contracts import Risk
+
+PHONE = re.compile(r"\+?(?:\(?\d[\s().-]*){6,}\d\)?")
+
+
+def redact(s):
+    return PHONE.sub("a phone number", str(s or ""))
+
+
+def normalize(text):
+    text = unicodedata.normalize("NFKC", text or "")
+    return " ".join("".join(c for c in text if unicodedata.category(c) != "Cf").lower().split())
+
+
+CATEGORIES = {
+    "technical support request": r"\b(?:call|contact)\s+(?:microsoft|apple|windows|tech(?:nical)?\s+support)\b",
+    "computer locked or infected": r"\bcomputer\s+(?:(?:is|has been)\s+)?(?:infected|locked|blocked)\b|\bvirus(?:es)?\s+(?:detected|found)\b",
+    "request to keep the page open": r"\bdo not\s+(?:close|restart|turn off)\b|\bdon't\s+(?:close|restart|turn off)\b",
+    "unusual payment request": r"\bgift\s+cards?\b|\bwire\s+transfer\b|\bbitcoin\s+atm\b|\bcrypto(?:currency)?\b",
+    "account suspension claim": r"\baccount\s+(?:(?:is|has been)\s+)?(?:suspended|frozen|blocked)\b",
+    "government impersonation claim": r"\b(?:irs|medicare|social security)\b.{0,100}\b(?:arrest\w*|owe\w*|suspend\w*)\b|\b(?:arrest\w*|owe\w*|suspend\w*)\b.{0,100}\b(?:irs|medicare|social security)\b",
+    "urgent deadline": r"\bimmediately\b|\bwithin\s+24\s+hours\b|\bfinal notice\b",
+}
+
+
+def check_text(text, url=""):
+    text = normalize(text)
+    categories = [name for name, pattern in CATEGORIES.items() if re.search(pattern, text)]
+    core = [c for c in categories if c != "urgent deadline"]  # urgency alone never makes a scam
+    high = (("technical support request" in categories and (PHONE.search(text) or len(categories) >= 2))
+            or len(core) >= 3 or ("unusual payment request" in categories and len(core) >= 2))
+    gov_urgent = "government impersonation claim" in categories and len(categories) > len(core)
+    if not high and len(core) < 2 and not gov_urgent:
+        return []
+    return [Risk("scam_popup", "high" if high else "medium",
+                 redact("Page signals: " + "; ".join(categories)), url=url, source="text")]
