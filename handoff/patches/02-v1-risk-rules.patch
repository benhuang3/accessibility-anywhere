+    def test_process_names(self):
+        names = ['AnY DeSk.EXE', 'Rust Desk.exe', 'Zoho Assist.EXE', 'notepad.exe', 'anydesk.exe']
+        self.assertEqual([r.app for r in check_process_names(names)], ['anydesk', 'rustdesk', 'zohoassist'])
+        self.assertEqual(check_process_names(['notepad.exe']), [])
+
+    def test_process_inventory(self):
+        with patch('ally.risk.process.sys.platform', 'linux'), patch('ally.risk.process.subprocess.run') as run:
+            self.assertEqual(running_process_names(), [])
+            run.assert_not_called()
+        with patch('ally.risk.process.sys.platform', 'win32'), \
+             patch('ally.risk.process.subprocess.CREATE_NO_WINDOW', 0x08000000, create=True), \
+             patch('ally.risk.process.subprocess.run', return_value=SimpleNamespace(stdout='"AnyDesk.exe","42"\n')) as run:
+            self.assertEqual(running_process_names(), ['AnyDesk.exe'])
+            self.assertEqual(run.call_args.kwargs['timeout'], 5)
+            self.assertEqual(run.call_args.kwargs['creationflags'], 0x08000000)
+        with patch('ally.risk.process.sys.platform', 'win32'), \
+             patch('ally.risk.process.subprocess.run', side_effect=OSError):
+            self.assertEqual(running_process_names(), [])
+
+    def test_wire(self):
+        calls, risks = [], []
+        agent = SimpleNamespace(bus=EventBus(), bridge=SimpleNamespace(on_page=None,
+                                broadcast=lambda *args: calls.append(args)))
+        agent.bus.subscribe('risk', risks.append)
+        with patch('ally.risk.wire.running_process_names', return_value=[]):
+            handle = attach(agent)
+            try:
+                page = {'url': 'https://paypa1.com', 'title': 'title', 'text': '', 'fields': {'payment': True}}
+                agent.bridge.on_page(page)
+                agent.bridge.on_page(page)
+                self.assertEqual(len(risks), 2)
+                agent.bus.publish('risk_warning', {'risk': risks[0].to_dict(), 'text': 'unused'})
+                agent.bus.publish('risk_warning', Risk('remote_access'))
+                self.assertEqual(calls, [('showRiskBanner', {'url': page['url'], 'kind': 'untrusted_site',
+                                                           'text': BANNERS['untrusted_site']})])
+            finally:
+                handle.stop()
+            self.assertFalse(handle.thread.is_alive())
+            self.assertIsNone(agent.bridge.on_page)
+            agent.bus.publish('risk_warning', risks[0])
+            self.assertEqual(len(calls), 1)
+
+    def test_wire_process_once(self):
+        got = threading.Event()
+        risks = []
+        agent = SimpleNamespace(bus=EventBus(), bridge=SimpleNamespace(on_page=None, broadcast=lambda *a: None))
+        agent.bus.subscribe('risk', lambda r: (risks.append(r), got.set()))
+        with patch('ally.risk.wire.running_process_names', return_value=['Rust Desk.exe', 'rustdesk.EXE']):
+            handle = attach(agent)
+            try:
+                self.assertTrue(got.wait(2))
+            finally:
+                handle.stop()
+        self.assertEqual([r.app for r in risks], ['rustdesk'])
+
