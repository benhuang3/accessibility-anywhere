+"""Duck-typed integration, independent of the agent and bridge modules."""
+import threading
+from ..contracts import Risk
+from . import BANNERS, Deduper, enable_demo_brands, scan_page
+from .process import check_process_names, running_process_names
+
+
+class _Attachment:
+    def __init__(self, agent):
+        self.agent = agent
+        cfg = getattr(agent, "proactive_cfg", None)
+        enable_demo_brands(bool(cfg and cfg().get("demo_brands", False)))
+        self.done = threading.Event()
+        self.deduper = Deduper()
+        self.previous = getattr(agent.bridge, "on_page", None)
+        self.on_page = self._on_page
+        agent.bridge.on_page = self.on_page
+        self.unsubscribe = agent.bus.subscribe("risk_warning", self._warning)
+        self.thread = threading.Thread(target=self._poll, name="ally-risk-processes", daemon=True)
+        self.thread.start()
+
+    def _on_page(self, page):
+        if self.done.is_set() or not isinstance(page, dict):
+            return
+        for risk in scan_page(page.get("url"), page.get("text"), page.get("fields")):
+            if self.deduper.fresh(risk):
+                self.agent.bus.publish("risk", risk)
+
+    def _warning(self, message):
+        if self.done.is_set():
+            return
+        risk = message.get("risk", message) if isinstance(message, dict) else message
+        url = risk.get("url", "") if isinstance(risk, dict) else risk.url
+        kind = risk.get("kind", "") if isinstance(risk, dict) else risk.kind
+        if url and kind in BANNERS:
+            self.agent.bridge.broadcast("showRiskBanner", {"url": url, "kind": kind, "text": BANNERS[kind]})
+
+    def _poll(self):
+        seen = set()
+        while not self.done.is_set():
+            try:
+                for risk in check_process_names(running_process_names()):
+                    if self.done.is_set():
+                        return
+                    if risk.app not in seen:
+                        seen.add(risk.app)
+                        self.agent.bus.publish("risk", risk)
+            except Exception:
+                events = getattr(self.agent, "events", None)
+                if events is not None:
+                    events.add("risk", "The remote access tool check was unavailable.")
+            if self.done.wait(10):
+                break
+
+    def stop(self):
+        self.done.set()
+        if callable(self.unsubscribe):
+            self.unsubscribe()
+        if self.agent.bridge.on_page is self.on_page:
+            self.agent.bridge.on_page = self.previous
+        if threading.current_thread() is not self.thread:
+            self.thread.join(timeout=6)
+
+
+def attach(agent):
+    return _Attachment(agent)
