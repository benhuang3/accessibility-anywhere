+"""Remote tool signals and optional Windows process inventory."""
+import csv
+import io
+import re
+import subprocess
+import sys
+from ..contracts import Risk
+from .text import redact
+
+REMOTE_TOOLS = ("anydesk", "teamviewer", "ultraviewer", "quickassist", "supremo",
+                "logmein", "screenconnect", "rustdesk", "splashtop", "aeroadmin",
+                "ammyy", "zohoassist", "getscreen")
+
+
+def check_process_names(names):
+    found = {}
+    for name in names:
+        normalized = re.sub(r"\s+", "", str(name).lower()).removesuffix(".exe")
+        for tool in REMOTE_TOOLS:
+            if tool in normalized:
+                found.setdefault(tool, Risk("remote_access", "high", redact(tool + " is running"),
+                                           app=tool, source="process"))
+    return list(found.values())
+
+
+def running_process_names():
+    if sys.platform != "win32":
+        return []
+    try:
+        result = subprocess.run(["tasklist", "/fo", "csv", "/nh"], capture_output=True,
+                                text=True, timeout=5, check=True,
+                                creationflags=subprocess.CREATE_NO_WINDOW)
+        return [row[0] for row in csv.reader(io.StringIO(result.stdout)) if row]
+    except Exception:
+        return []
