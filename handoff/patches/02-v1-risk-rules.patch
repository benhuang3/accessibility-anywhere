+"""Risk rules and integration, without a live browser or process inventory."""
+import re
+import sys
+import threading
+import unittest
+from types import SimpleNamespace
+from unittest.mock import patch
+from pathlib import Path
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from ally.contracts import Risk, EventBus, RISK_KINDS
+from ally.risk import (check_url, check_text, check_process_names, scan_page,
+                       warning_for, redact, Deduper, WARNINGS, BANNERS)
+from ally.risk.domains import normalize_host, registrable_domain, skeleton, distance
+from ally.risk.fields import check_fields
+from ally.risk.process import running_process_names, REMOTE_TOOLS
+from ally.risk.wire import attach
+
+
+class DomainTests(unittest.TestCase):
+    def test_digit_lookalike(self):
+        self.assertEqual(check_url('https://paypa1.com')[0].severity, 'high')
+
+    def test_letter_pair(self):
+        self.assertEqual(check_url('https://rnicrosoft.com')[0].severity, 'high')
+
+    def test_cyrillic_and_idna(self):
+        host = '\u0430pple.com'
+        for h in (host, host.encode('idna').decode()):
+            self.assertEqual(check_url('https://' + h)[0].severity, 'high')
+
+    def test_mixed_scripts(self):
+        self.assertEqual(check_url('https://abc\u0430def.net')[0].severity, 'high')
+
+    def test_typo(self):
+        self.assertEqual(check_url('https://paypall.com')[0].severity, 'medium')
+
+    def test_short_brands_not_fuzzy(self):
+        # one edit from real words: usa, apply, case, its, chases
+        for h in ('usa.gov', 'apply.com', 'case.edu', 'its.com', 'chases.com'):
+            self.assertEqual(check_url('https://' + h), [], h)
+
+    def test_regional_real_domains_and_digit_tokens(self):
+        for h in ('www.amazon.co.uk', 'www.amazon.ca'):
+            self.assertEqual(check_url('https://' + h), [], h)
+        self.assertEqual(check_url('https://amaz0n-help.com')[0].severity, 'medium')
+
+    def test_tokens(self):
+        for h in ('paypal-verify.net', 'paypal.com.secure-login.xyz'):
+            self.assertEqual(check_url('https://' + h)[0].severity, 'medium')
+
+    def test_ip(self):
+        self.assertEqual(check_url('http://192.168.1.1')[0].severity, 'medium')
+
+    def test_clean_unrelated(self):
+        for h in ('pineapple.com', 'chaseoutdoors.com', 'applebees.com', 'recipes.net'):
+            self.assertEqual(check_url('https://' + h), [], h)
+
+    def test_clean_real_domains(self):
+        for h in ('www.paypal.com', 'smile.amazon.com', 'login.live.com', 'icloud.com',
+                  'help.office.com', 'ssa.gov', 'www.medicare.gov', 'paypa1.amazon.com'):
+            self.assertEqual(check_url('https://' + h), [], h)
+
+    def test_remote_hosts(self):
+        for tool in REMOTE_TOOLS:
+            self.assertEqual(check_url('https://' + tool + '.com/download')[0].kind, 'remote_access')
+
+    def test_normalization(self):
+        self.assertEqual(normalize_host('https://WWW.PayPal.COM./a'), 'paypal.com')
+        self.assertEqual(registrable_domain('login.bank.co.uk'), 'bank.co.uk')
+        self.assertEqual(skeleton('rn1cr0s0ft'), 'mlcrosoft')
+        self.assertEqual(distance('chase', 'chsae'), 1)
+
+    def test_malformed(self):
+        for url in ('', 'http://[bad', 'https://xn--.com'):
+            self.assertEqual(check_url(url), [])
+
+
+class TextTests(unittest.TestCase):
+    def test_clean(self):
+        self.assertEqual(check_text('Welcome to the recipe blog'), [])
+
+    def test_single_soft(self):
+        for t in ('Final notice', 'Your account is suspended', 'Buy gift cards', 'Call Microsoft Support'):
+            self.assertEqual(check_text(t), [])
+
+    def test_support_phone(self):
+        self.assertEqual(check_text('Call Microsoft support +1 (800) 555-1212')[0].severity, 'high')
+
+    def test_existing_scam(self):
+        self.assertEqual(check_text('WARNING! Your computer has been locked. Call Microsoft Support')[0].kind,
+                         'scam_popup')
+
+    def test_two_medium(self):
