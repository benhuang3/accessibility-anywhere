+        risks += [Risk(k, evidence='Contact +1 (800) 555-1212 or 123456789') for k in RISK_KINDS]
+        for risk in risks:
+            for output in (redact(risk.evidence), *warning_for(risk)):
+                self.assertIsNone(re.search(r'\d(?:[\s().-]*\d){6}', output))
+            self.assertIn('Why:', warning_for(risk)[0])
+        for risk in risks[:4]:
