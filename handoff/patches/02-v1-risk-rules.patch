+        d = Deduper(10, lambda: now[0])
+        r = Risk('scam_popup', url='https://example.com/a')
+        self.assertTrue(d.fresh(r))
+        now[0] = 9
+        self.assertFalse(d.fresh(Risk('scam_popup', url='https://example.com/b')))
