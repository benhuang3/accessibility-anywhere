@@ -0,0 +1,120 @@
+"""Conservative domain identity checks; no network requests."""
+import ipaddress
+import re
+import unicodedata
+from urllib.parse import urlsplit
+from ..contracts import Risk
+from .text import redact
+from .process import REMOTE_TOOLS
+
+BRANDS = {
+    "paypal": ("paypal.com",), "chase": ("chase.com",),
+    "wellsfargo": ("wellsfargo.com",), "bankofamerica": ("bankofamerica.com",),
+    "amazon": ("amazon.com", "amazon.co.uk", "amazon.ca", "amazon.de", "amazon.in", "amazon.com.au", "amazon.co.jp"), "apple": ("apple.com", "icloud.com"),
+    "microsoft": ("microsoft.com", "live.com", "office.com"),
+    "irs": ("irs.gov",), "medicare": ("medicare.gov",), "ssa": ("ssa.gov",),
+}
+# Short brands (irs, ssa, apple, chase) sit one edit from real words (usa, apply, case), so only the
+# exact-skeleton and whole-token checks apply to them; edit distance is for longer, distinctive names.
+FUZZY_MIN = 6
+# An invented brand for the local demo page only (never a real organization). Off unless enabled.
+DEMO_BRANDS = {"pinecrest": ("pinecrest.example",)}
+
+
+def enable_demo_brands(on=True):
+    for brand, domains in DEMO_BRANDS.items():
+        if on:
+            BRANDS[brand] = domains
+        else:
+            BRANDS.pop(brand, None)
+
+SECOND_LEVELS = {"co", "com", "org", "gov", "net", "ac"}
+# Common Cyrillic and Greek visual substitutes, including lowercase forms.
+FOLDS = str.maketrans(dict(zip(
+    "\u0430\u0435\u043e\u0440\u0441\u0443\u0445\u0456\u0458\u0455\u043a\u043c\u0442\u0432\u043d\u04cf\u0501\u051b"
+    "\u03b1\u03b2\u03b5\u03b9\u03ba\u03bd\u03bf\u03c1\u03c4\u03c5\u03c7\u03f2" + "0135",
+    "aeopcyxijskmtbhldq" + "abeikvoptyxc" + "oles")))
+
+
+def normalize_host(url):
+    try:
+        host = urlsplit(url if "://" in url or url.startswith("//") else "//" + url).hostname or ""
+        labels = []
+        for label in host.lower().rstrip(".").split("."):
+            labels.append(label.encode("ascii").decode("idna") if label.startswith("xn--") else label)
+        return ".".join(labels).lower().removeprefix("www.")
+    except (ValueError, UnicodeError):
+        return ""
+
+
+def registrable_domain(host):
+    labels = host.split(".")
+    count = 3 if len(labels) >= 3 and len(labels[-1]) == 2 and labels[-2] in SECOND_LEVELS else 2
+    return ".".join(labels[-count:])
+
+
+def skeleton(label):
+    return label.lower().translate(FOLDS).replace("rn", "m").replace("vv", "w")
+
+
+def mixed_scripts(label):
+    scripts = set()
+    for char in label:
+        if char.isalpha():
+            name = unicodedata.name(char, "")
+            scripts.add(next((s for s in ("LATIN", "CYRILLIC", "GREEK") if s in name), "OTHER"))
+    return len(scripts) > 1
+
+
+def distance(a, b):
+    """Damerau-Levenshtein distance, including adjacent transpositions."""
+    # Unrestricted algorithm with last-seen character positions.
+    size = len(a) + len(b)
+    d = [[0] * (len(b) + 2) for _ in range(len(a) + 2)]
+    d[0][0] = size
+    for i in range(len(a) + 1):
+        d[i + 1][0], d[i + 1][1] = size, i
+    for j in range(len(b) + 1):
+        d[0][j + 1], d[1][j + 1] = size, j
+    last = {}
+    for i, ca in enumerate(a, 1):
+        match = 0
+        for j, cb in enumerate(b, 1):
+            i1, j1 = last.get(cb, 0), match
+            cost = int(ca != cb)
+            if not cost:
+                match = j
+            d[i + 1][j + 1] = min(d[i][j] + cost, d[i + 1][j] + 1, d[i][j + 1] + 1,
+                                  d[i1][j1] + i - i1 - 1 + 1 + j - j1 - 1)
+        last[ca] = i
+    return d[-1][-1]
+
+
+def check_url(url):
+    host = normalize_host(url)
+    if not host:
+        return []
+    # A trusted domain and every subdomain are exempt from identity heuristics.
+    if any(host == real or host.endswith("." + real) for domains in BRANDS.values() for real in domains):
+        return []
+    labels = host.split(".")
+    tokens = re.split(r"[.-]", host)
+    if any(tool in skeleton(token) for tool in REMOTE_TOOLS for token in tokens):
+        return [Risk("remote_access", "high", redact("The address refers to a remote access tool"), url=url, source="url")]
+    reason, severity = "", "medium"
+    try:
+        if isinstance(ipaddress.ip_address(host), ipaddress.IPv4Address):
+            reason = "The address uses an IP address instead of a website name"
+    except ValueError:
+        pass
+    if any(mixed_scripts(label) for label in labels):
+        reason, severity = "An address label mixes writing systems", "high"
+    elif any(skeleton(label) == brand and label != brand for label in labels for brand in BRANDS):
+        reason, severity = "An address label resembles a known organization outside its usual domain", "high"
+    elif any(skeleton(token) in BRANDS for token in tokens):
+        reason = "The address uses an organization name outside its usual domain"
+    elif any(distance(skeleton(label), brand) <= (2 if len(brand) >= 8 else 1)
+             for label in labels for brand in BRANDS if len(brand) >= FUZZY_MIN
+             if abs(len(skeleton(label)) - len(brand)) <= (2 if len(brand) >= 8 else 1)):
+        reason = "The address closely resembles a known organization"
+    return [Risk("untrusted_site", severity, redact(reason), url=url, source="url")] if reason else []
