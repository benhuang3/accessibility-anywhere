# Copy this file to .env (same folder as run.py) and fill in your keys.
# Never commit .env to git.

# Required for the AI brain (without it Ally runs in offline mode with simple commands).
ANTHROPIC_API_KEY=

# Optional: Cartesia natural voice and spoken yes/no answers. Also set [speech] cartesia_voice_id
# in config.toml (python run.py voices lists them). Without it Ally uses the built-in voice.
CARTESIA_API_KEY=
